{
  "name": "barcoded",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build && node scripts/write-register-sw.js",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:eslint": "eslint . --fix --cache",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal public/code-icon.svg"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "bwip-js": "^4.2.0",
    "dexie": "^4.4.6",
    "uuid": "^14.0.2",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/bwip-js": "^3.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/uuid": "^10.0.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "~10.11.0",
    "fake-indexeddb": "^6.2.5",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "node": "^24.12.0"
  }
}
